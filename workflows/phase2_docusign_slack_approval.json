    {
      "parameters": {
        "jsCode": "// Slack payload parsing logic\nconst rawBody = $json.body || $json;\nconst payloadString = typeof rawBody.payload === 'string' ? rawBody.payload : JSON.stringify(rawBody.payload);\nconst slackData = JSON.parse(payloadString);\n\n// Action value extract karna (e.g. \"approve_c3d55fd6-7923...\")\nconst actionValue = slackData.actions[0].value || ''; \nconst isApproved = actionValue.startsWith('approve');\n\n// ID extract karna (agar approve_ ya reject_ prefix ho toh usay hata kar sirf UUID lena)\nlet candidateId = actionValue;\nif (actionValue.includes('_')) {\n  candidateId = actionValue.split('_').slice(1).join('_'); // Extra safety for UUIDs\n}\n\nconst managerName = slackData.user.name || slackData.user.username || 'Manager';\nconst responseUrl = slackData.response_url;\n\nreturn {\n  candidateId: candidateId,\n  isApproved: isApproved,\n  managerName: managerName,\n  responseUrl: responseUrl\n};"
      },
