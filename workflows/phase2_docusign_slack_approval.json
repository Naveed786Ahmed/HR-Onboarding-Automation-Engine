        "jsonBody": "={\n  \"channel\": \"C0CDD4KRAUB\",\n  \"text\": \"New Candidate Contract Signed - Approval Required\",\n  \"blocks\": [\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"📋 *New Onboarding Approval Request*\\n• *Candidate:* {{ $json.candidate_name }}\\n• *Experience:* {{ $json.years_experience }} Years\\n• *AI Qualification Score:* `{{ $json.qualification_score }}/100`\\n• *Status:* Contract Signed ✅\"\n      }\n    },\n    {\n      \"type\": \"actions\",\n      \"elements\": [\n        {\n          \"type\": \"button\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"✅ Approve Onboarding\"\n          },\n          \"style\": \"primary\",\n          \"value\": \"approve_{{ $json.id }}\"\n        },\n        {\n          \"type\": \"button\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"❌ Reject\"\n          },\n          \"style\": \"danger\",\n          \"value\": \"reject_{{ $json.id }}\"\n        }\n      ]\n    }\n  ]\n}",
